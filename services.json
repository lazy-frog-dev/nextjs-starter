{
  "services": {
    "web": {
      "type": "web",
      "dev": "exec ./node_modules/.bin/next dev --hostname 0.0.0.0 --port $PORT",
      "build": "pnpm build",
      "start": "exec ./node_modules/.bin/next start --hostname 0.0.0.0 --port $PORT",
      "port": 3000,
      "healthcheck_path": "/api/health"
    }
  }
}
